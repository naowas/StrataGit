{
  "name": "stratagit",
  "productName": "StrataGit",
  "version": "0.3.0",
  "description": "A commit-graph-centric visual Git client for Linux, macOS, and Windows",
  "main": "out/main/index.js",
  "author": {
    "name": "StrataGit Team",
    "email": "support@stratagit.dev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "demo:create": "node scripts/create-demo-repos.cjs",
    "test:features": "node scripts/test-features.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb rpm pacman --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@gitgraph/core": "^1.5.0",
    "@gitgraph/js": "^1.4.0",
    "@gitgraph/react": "^1.6.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.469.0",
    "simple-git": "^3.27.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "dev.stratagit.app",
    "productName": "StrataGit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "naowas",
      "repo": "StrataGit",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "maintainer": "support@stratagit.dev",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  }
}
